{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://az104-study-desk.local/schemas/question-v3.json",
  "title": "AZ-104 question version 3",
  "description": "Cross-field ID, domain membership, and selection checks are enforced by electron/validation.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "blueprintVersion",
    "domainId",
    "objectiveId",
    "title",
    "prompt",
    "type",
    "options",
    "correctOptionIds",
    "explanation",
    "references",
    "source",
    "reviewedAt",
    "primarySkillId",
    "relatedSkillIds",
    "familyId",
    "mappingVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "blueprintVersion": {
      "const": "2026-04-17"
    },
    "domainId": {
      "enum": ["identity", "storage", "compute", "networking", "monitoring"]
    },
    "objectiveId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["single", "multiple"]
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "rationale"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "correctOptionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://learn\\.microsoft\\.com/"
          }
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "author", "license", "revision", "url", "section", "changes"],
          "properties": {
            "kind": {
              "const": "adapted-public"
            },
            "author": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "const": "MIT"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "section": {
              "type": "string",
              "minLength": 1
            },
            "changes": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "jobId",
            "model",
            "reviewModel",
            "promptVersion",
            "reviewBasis",
            "evidence"
          ],
          "properties": {
            "kind": {
              "const": "ai-generated"
            },
            "reviewBasis": {
              "const": "automated"
            },
            "jobId": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "reviewModel": {
              "type": "string",
              "minLength": 1
            },
            "promptVersion": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "documentId",
                  "url",
                  "title",
                  "sectionId",
                  "revision",
                  "fetchedAt",
                  "excerpt"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "documentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sectionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fetchedAt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "excerpt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "attribution": {
                    "type": "string"
                  },
                  "license": {
                    "type": "string"
                  },
                  "licenseUrl": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date"
    },
    "code": {
      "type": "object",
      "required": ["language", "text"],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "primarySkillId": {
      "type": "string"
    },
    "relatedSkillIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "familyId": {
      "type": "string",
      "minLength": 1
    },
    "mappingVersion": {
      "type": "string"
    },
    "correctsVersions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "selectionCount": {
      "type": "integer",
      "minimum": 1
    },
    "difficulty": {
      "enum": ["easy", "medium", "hard"]
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "single"
          }
        }
      },
      "then": {
        "properties": {
          "correctOptionIds": {
            "maxItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "correctOptionIds": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
